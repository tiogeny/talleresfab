# Desactivar caché agresivo para datos dinámicos y HTML
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|js|json)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|jfif)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Desactivar LiteSpeed Cache interno para recargas inmediatas
<IfModule LiteSpeed>
  CacheDisable public /
  CacheDisable private /
</IfModule>

# Seguridad y Protección
# 1. Proteger archivos JSON internos, logs y datos del acceso web directo
<FilesMatch "\.(json|lock|log|md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 2. Despistar escáneres y bots hacia /admin (simular que no existe con 404)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^admin(/.*)?$ - [R=404,L]
</IfModule>
